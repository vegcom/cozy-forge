# Try to use USER_TMP: advise ~/scratch
# shellcheck disable=SC2034
TMPDIR="${USER_TMPDIR:-$TMPDIR}"

# Disable pip cache w 1 to save space
# shellcheck disable=SC2034
PIP_NO_CACHE_DIR="${PIP_NO_CACHE_DIR:-1}"

# Define conda/pip cache dir paths
# shellcheck disable=SC2034
PIP_CACHE_DIR="${TMPDIR}/pip-cache"
CONDA_PKGS_DIRS="${TMPDIR}/mamba-cache"


# Prevent .pyc files and __pycache__
PYTHONDONTWRITEBYTECODE="1"

export PYTHONDONTWRITEBYTECODE CONDA_PKGS_DIRS PIP_CACHE_DIR PIP_NO_CACHE_DIR TMPDIR USER_TMPDIR
