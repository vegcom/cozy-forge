{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "cozy": {
      "format": "\u001b[1;36m⚙️  [%(name)s]\u001b[0m %(asctime)s - %(levelname)s - %(pid_tag)s%(message)s",
      "datefmt": "%H:%M:%S"
    },
    "cozy_error": {
      "format": "\u001b[1;31m🚨 [%(name)s]\u001b[0m %(asctime)s - %(levelname)s - %(pid_tag)s%(message)s",
      "datefmt": "%H:%M:%S"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "formatter": "cozy",
      "level": "DEBUG",
      "stream": "ext://sys.stderr"
    },
    "console_error": {
      "class": "logging.StreamHandler",
      "formatter": "cozy_error",
      "level": "ERROR",
      "stream": "ext://sys.stderr"
    }
  },
  "loggers": {
    "forge": {
      "level": "DEBUG",
      "handlers": ["console"],
      "propagate": false
    },
    "health_check": {
      "level": "DEBUG",
      "handlers": ["console"],
      "propagate": false
    }
  },
  "root": {
    "level": "WARNING",
    "handlers": ["console"]
  }
}
